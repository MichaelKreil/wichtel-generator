# Cache rules for static files on Cloudflare (the Node server sets the same in src/server.ts).
# style.css, themes.css and app.js are linked with ?v=<hash> (npm run assets), so they can be cached for good.
# Other files keep their names when they change, so they are only cached briefly.
# Pages get their security headers from the app; static files at least this one.
/*
  X-Content-Type-Options: nosniff

/static/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/static/style.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/themes.css
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/app.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/static/img/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000

/static/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
