{
	"name": "wichtel-generator",
	"private": true,
	"version": "2.0.0",
	"description": "Online-Wichteltopf: Teilnehmende eintragen, Topf schließen, Wichtel auslosen.",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"start": "node src/server.ts",
		"dev": "node --watch src/server.ts",
		"test": "node --test \"test/**/*.test.ts\"",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"check": "npm run typecheck && npm run lint && npm test",
		"images": "./scripts/build-images.sh",
		"upgrade": "npx npm-check-updates -u && npm install"
	},
	"author": "Michael Kreil",
	"license": "MIT",
	"dependencies": {
		"@hono/node-server": "^2.1.5",
		"hono": "^4.13.13"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^24.0.0",
		"typescript": "^7.0.2"
	}
}
