{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wichteltopf",
	"main": "src/worker.ts",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "public"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wichteltopf",
			// from `npx wrangler d1 create wichteltopf`
			"database_id": "1c47009a-ad6d-4ebd-814f-a131f4806191",
			"migrations_dir": "migrations"
		}
	],
	// Per-IP limits for form submissions (keep in sync with src/server.ts)
	"ratelimits": [
		{ "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
		{ "name": "WRITE_LIMITER", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
	],
	"vars": {
		"POT_TTL_DAYS": "90"
	},
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	"observability": {
		"enabled": true
	},
	"routes": [
		{ "pattern": "wichteltopf.de", "custom_domain": true },
		{ "pattern": "www.wichteltopf.de", "custom_domain": true }
	]
}
